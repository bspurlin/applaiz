import { useEffect, useState } from "react";

export default function App() {
    const [dirobj, setDirobj] = useState('{"d":"applaiz"}'); // {  }
    const [status, setStatus] = useState("loading"); // loading 
    const [myChoiceId, setMyChoiceId] = useState(null);
    const [errorMsg, setErrorMsg] = useState("");

        const options = {
            mode: 'cors',
            method: 'POST',
            headers: {
                "Content-Type": "application/json",
            },
             body: dirobj
        };
 

    useEffect(() => {
	fetch("/dirobj", options)
	    .then((res) => {
		if (!res.ok) throw new Error("Failed to load the question.");
		return res.json();
	    })
	    .then((data) => {
		setDirobj(data);
		setStatus("ready");
	    })
	    .catch((err) => {
		setErrorMsg(err.message);
		setStatus("error");
	    });
    }, [dirobj]);

    console.log(dirobj);
	setDirobj('{"d":"42NLPfDel9xIcwVmRW-JEw"}');
	console.log(dirobj);
}
